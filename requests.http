### Health check (open)
GET http://localhost:8080/api/health

### Login as manager
# @name loginManager
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "dana", "password": "password123"}

> {% client.global.set("managerToken", response.body.token); %}

### Login as employee
# @name loginEmployee
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "maya", "password": "password123"}

> {% client.global.set("employeeToken", response.body.token); %}

### Current user - manager
GET http://localhost:8080/api/auth/me
Authorization: Bearer {{managerToken}}

### Current user - no token, expect 401
GET http://localhost:8080/api/auth/me

### Manager endpoint with manager token, expect 200
GET http://localhost:8080/api/debug/manager-only
Authorization: Bearer {{managerToken}}

### Manager endpoint with employee token, expect 403
GET http://localhost:8080/api/debug/manager-only
Authorization: Bearer {{employeeToken}}

### Employee endpoint with employee token, expect 200
GET http://localhost:8080/api/debug/employee-only
Authorization: Bearer {{employeeToken}}

### Wrong password, expect 401
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "dana", "password": "wrong"}

### Disabled account, expect 401
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "avi", "password": "password123"}

### List positions
GET http://localhost:8080/api/job-positions
Authorization: Bearer {{managerToken}}

### Create position
POST http://localhost:8080/api/job-positions
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{"name": "Team lead"}

### Duplicate name, expect 409
POST http://localhost:8080/api/job-positions
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{"name": "Support agent"}

### Empty name, expect 400
POST http://localhost:8080/api/job-positions
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{"name": ""}

### Employee tries to create, expect 403
POST http://localhost:8080/api/job-positions
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{"name": "Hacker"}

### Delete position in use, expect 409
DELETE http://localhost:8080/api/job-positions/1
Authorization: Bearer {{managerToken}}

### Not found, expect 404
GET http://localhost:8080/api/job-positions/999
Authorization: Bearer {{managerToken}}