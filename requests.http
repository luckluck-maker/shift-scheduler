### ============================================================
### 1 — No session
### Run these first, before any login
### ============================================================

### Health check, open endpoint
GET http://localhost:8080/api/health

### Current user without a session, expect 401
GET http://localhost:8080/api/auth/me

### Wrong password, expect 401
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "dana", "password": "password123X"}

### Disabled account, expect 401
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "avi", "password": "password123"}


### ============================================================
### 2 — Manager session
### ============================================================

### Login as manager
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "dana", "password": "password123"}

### Current user, expect 200 MANAGER
GET http://localhost:8080/api/auth/me

### Manager endpoint, expect 200
GET http://localhost:8080/api/debug/manager-only


### --- Job positions ---

### List positions
GET http://localhost:8080/api/job-positions

### Create position
POST http://localhost:8080/api/job-positions
Content-Type: application/json

{"name": "Team lead"}

### Duplicate name, expect 409
POST http://localhost:8080/api/job-positions
Content-Type: application/json

{"name": "Support agent"}

### Empty name, expect 400
POST http://localhost:8080/api/job-positions
Content-Type: application/json

{"name": ""}

### Delete position in use, expect 409
DELETE http://localhost:8080/api/job-positions/1

### Not found, expect 404
GET http://localhost:8080/api/job-positions/999


### --- Shift types ---

### List shift types
GET http://localhost:8080/api/shift-types

### Create a shift crossing midnight
POST http://localhost:8080/api/shift-types
Content-Type: application/json

{"name": "Late night", "startTime": "22:00", "endTime": "06:00"}

### Same start and end, expect 400
POST http://localhost:8080/api/shift-types
Content-Type: application/json

{"name": "Broken", "startTime": "08:00", "endTime": "08:00"}


### --- Employees ---

### List employees
GET http://localhost:8080/api/employees

### Create employee
POST http://localhost:8080/api/employees
Content-Type: application/json

{"fullName": "Roni Katz", "username": "roni", "password": "password123",
  "role": "EMPLOYEE", "maxWeeklyHours": 40, "jobPositionId": 2}

### Duplicate username, expect 409
POST http://localhost:8080/api/employees
Content-Type: application/json

{"fullName": "Fake", "username": "maya", "password": "password123",
  "role": "EMPLOYEE", "maxWeeklyHours": 40, "jobPositionId": 2}

### Non-existent job position, expect 404
POST http://localhost:8080/api/employees
Content-Type: application/json

{"fullName": "Ghost", "username": "ghost", "password": "password123",
  "role": "EMPLOYEE", "maxWeeklyHours": 40, "jobPositionId": 999}

### Short password, expect 400
POST http://localhost:8080/api/employees
Content-Type: application/json

{"fullName": "Short", "username": "shorty", "password": "123",
  "role": "EMPLOYEE", "maxWeeklyHours": 40, "jobPositionId": 2}

### Deactivate the only manager, expect 400
DELETE http://localhost:8080/api/employees/1


### --- Schedules ---

### Create a work week, expect 201 with 21 shifts
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-08-09",
  "shifts": [
    { "shiftTypeId": 1, "requirements": [
      {"jobPositionId": 1, "requiredCount": 1},
      {"jobPositionId": 2, "requiredCount": 2}
    ]},
    { "shiftTypeId": 2, "requirements": [
      {"jobPositionId": 2, "requiredCount": 2}
    ]},
    { "shiftTypeId": 3, "requirements": [
      {"jobPositionId": 2, "requiredCount": 1}
    ]}
  ]
}

### List schedules as manager, expect the draft
GET http://localhost:8080/api/schedules

### Schedule detail, expect 21 shifts and status DRAFT
GET http://localhost:8080/api/schedules/1

### Duplicate week, expect 409
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-08-09",
  "shifts": [{ "shiftTypeId": 1, "requirements": [{"jobPositionId": 2, "requiredCount": 1}] }]
}

### Unknown shift type, expect 404
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-09-06",
  "shifts": [{ "shiftTypeId": 999, "requirements": [{"jobPositionId": 2, "requiredCount": 1}] }]
}

### Unknown job position, expect 404
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-09-06",
  "shifts": [{ "shiftTypeId": 1, "requirements": [{"jobPositionId": 999, "requiredCount": 1}] }]
}

### Same shift type twice, expect 400
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-09-06",
  "shifts": [
    { "shiftTypeId": 1, "requirements": [{"jobPositionId": 2, "requiredCount": 1}] },
    { "shiftTypeId": 1, "requirements": [{"jobPositionId": 2, "requiredCount": 2}] }
  ]
}

### Empty shift list, expect 400
POST http://localhost:8080/api/schedules
Content-Type: application/json

{"weekStart": "2026-09-06", "shifts": []}

### Adjust requirements on a single shift, expect 200
PUT http://localhost:8080/api/schedules/1/shifts/1/requirements
Content-Type: application/json

{"requirements": [
  {"jobPositionId": 1, "requiredCount": 1},
  {"jobPositionId": 2, "requiredCount": 3},
  {"jobPositionId": 3, "requiredCount": 1}
]}

### Same job position twice, expect 400
PUT http://localhost:8080/api/schedules/1/shifts/1/requirements
Content-Type: application/json

{"requirements": [
  {"jobPositionId": 2, "requiredCount": 1},
  {"jobPositionId": 2, "requiredCount": 2}
]}

### Shift that belongs to another schedule, expect 400 or 404
PUT http://localhost:8080/api/schedules/1/shifts/999/requirements
Content-Type: application/json

{"requirements": [{"jobPositionId": 2, "requiredCount": 1}]}

### --- Leaves ---

### Create leave
POST http://localhost:8080/api/leaves
Content-Type: application/json

{"employeeId": 4, "startDate": "2026-08-10", "endDate": "2026-08-12", "type": "VACATION"}

### Overlapping leave, expect 409
POST http://localhost:8080/api/leaves
Content-Type: application/json

{"employeeId": 4, "startDate": "2026-08-12", "endDate": "2026-08-14", "type": "SICK"}

### End before start, expect 400
POST http://localhost:8080/api/leaves
Content-Type: application/json

{"employeeId": 4, "startDate": "2026-08-20", "endDate": "2026-08-18", "type": "SICK"}

### List all leaves
GET http://localhost:8080/api/leaves

### --- Preferences as manager ---

### Manager submits on behalf of employee 3
POST http://localhost:8080/api/shift-preferences
Content-Type: application/json

{"shiftId": 2, "type": "CANNOT", "reason": "Family event", "employeeId": 3}

### All preferences for the schedule
GET http://localhost:8080/api/shift-preferences?scheduleId=1

### Filter by one employee
GET http://localhost:8080/api/shift-preferences?scheduleId=1&employeeId=3


### ============================================================
### 3 — Employee session
### Logging in as an employee replaces the manager cookie
### ============================================================

### Login as employee
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "maya", "password": "password123"}

### Current user, expect 200 EMPLOYEE
GET http://localhost:8080/api/auth/me

### Employee endpoint, expect 200
GET http://localhost:8080/api/debug/employee-only

### Manager endpoint, expect 403
GET http://localhost:8080/api/debug/manager-only

### List employees, expect 403
GET http://localhost:8080/api/employees

### Create position, expect 403
POST http://localhost:8080/api/job-positions
Content-Type: application/json

{"name": "Hacker"}

### Create shift type, expect 403
POST http://localhost:8080/api/shift-types
Content-Type: application/json

{"name": "Nope", "startTime": "10:00", "endTime": "18:00"}

### Create a schedule, expect 403
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "weekStart": "2026-10-04",
  "shifts": [{ "shiftTypeId": 1, "requirements": [{"jobPositionId": 2, "requiredCount": 1}] }]
}

### List schedules while the only one is a draft, expect an empty array
GET http://localhost:8080/api/schedules

### Open the draft directly, expect 404
GET http://localhost:8080/api/schedules/1

### Employee submits own preference
POST http://localhost:8080/api/shift-preferences
Content-Type: application/json

{"shiftId": 5, "type": "PREFERS_NOT", "reason": "Long commute"}

### Same shift twice, expect 409
POST http://localhost:8080/api/shift-preferences
Content-Type: application/json

{"shiftId": 5, "type": "CANNOT"}

### Submit for someone else, expect 403
POST http://localhost:8080/api/shift-preferences
Content-Type: application/json

{"shiftId": 6, "type": "CANNOT", "employeeId": 4}

### Own preferences only
GET http://localhost:8080/api/shift-preferences?scheduleId=1

### Filter by someone else, the parameter is ignored
GET http://localhost:8080/api/shift-preferences?scheduleId=1&employeeId=3

### List leaves, expect 403
GET http://localhost:8080/api/leaves

### ============================================================
### 4 — Publishing changes what the employee can see
### ============================================================

### Back to manager
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "dana", "password": "password123"}

### Publish, expect 200 with status PUBLISHED
PUT http://localhost:8080/api/schedules/1/publish

### Publish again, expect 409
PUT http://localhost:8080/api/schedules/1/publish

### Modify a published schedule, expect 409
PUT http://localhost:8080/api/schedules/1/shifts/1/requirements
Content-Type: application/json

{"requirements": [{"jobPositionId": 2, "requiredCount": 5}]}

### Delete a published schedule, expect 409
DELETE http://localhost:8080/api/schedules/1

### Back to employee
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "maya", "password": "password123"}

### The same request now returns one entry
GET http://localhost:8080/api/schedules

### And the detail opens, expect 200
GET http://localhost:8080/api/schedules/1

### Submit after publish, expect 409
POST http://localhost:8080/api/shift-preferences
Content-Type: application/json

{"shiftId": 9, "type": "CANNOT"}

### ============================================================
### 5 — Employee created through the API can log in
### ============================================================

### Login as the employee created earlier
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"username": "roni", "password": "password123"}

### Current user, expect 200 with the id of roni
GET http://localhost:8080/api/auth/me


### ============================================================
### 6 — Logout
### Leaves the cookie jar clean for the next run
### ============================================================

### Log out, expect 204
POST http://localhost:8080/api/auth/logout

### Current user after logout, expect 401
GET http://localhost:8080/api/auth/me

### Protected endpoint after logout, expect 401
GET http://localhost:8080/api/job-positions
